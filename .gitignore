# =============================================================================
# Doc-Tron Project Gitignore
# =============================================================================

# =============================================================================
# Python / Backend
# =============================================================================

# Virtual environment
.venv/
venv/
env/
ENV/
env.bak/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# Python virtual environment files
.python-version
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environment variables (secrets!)
.env
.env.local
.env.*.local

# IDE / Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Jupyter Notebook
.ipynb_checkpoints/

# Data directory (likely user data)
data/*.db
data/*.sqlite
data/*.sqlite3

# =============================================================================
# Frontend / Vue.js
# =============================================================================

# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Build outputs
dist/
build/
*.min.js
*.min.css

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# TypeScript cache
.tsbuildinfo
*.tsbuildinfo

# Parcel
.cache/
.parcel-cache/

# Vue single file cache
.vue-component.cache/

# =============================================================================
# General / OS Specific
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.mime_types
.directory

# =============================================================================
# Testing
# =============================================================================

# Coverage reports
.coverage
htmlcov/
.tox/
.nox/

# pytest
.pytest_cache/
.coverage
htmlcov/

